# ============================================================
# SANGITA TRAVELS PUNE — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production values
# ============================================================

# HTTP Server Port
PORT=8080

# Deployment Environment (development / production)
ENVIRONMENT=production

# SQLite Database Location (relative to backend directory or absolute path)
DATABASE_PATH=data/bookings.db

# Cryptographic Secret Key for Session Signatures (Hex string)
ADMIN_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production

# Session duration in days
SESSION_EXPIRY_DAYS=30

# Business Contact Credentials & Helpline
BUSINESS_NAME="Sangita Travels Pune"
WHATSAPP_NUMBER=918261021008
SUPPORT_PHONE=8261021008
SUPPORT_EMAIL=shitalupadhye287@gmail.com
BUSINESS_ADDRESS="Pune, Maharashtra, India"

# Default Super Admin Credentials (seed/fallback)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=change_this_admin_password_in_production
ADMIN_DEFAULT_NAME="Shital Upadhye"
ADMIN_DEFAULT_EMAIL=shitalupadhye287@gmail.com
ADMIN_DEFAULT_PHONE=8261021008

# ============================================================
# WHATSAPP BUSINESS API (Cloud API / On-Premise)
# ============================================================
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
WHATSAPP_ADMIN_RECIPIENT=918261021008

# ============================================================
# EMAIL / SMTP NOTIFICATIONS
# ============================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sangitatravels08@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL="Sangita Travels Pune <sangitatravels08@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=shitalupadhye287@gmail.com

# ============================================================
# GOOGLE MAPS API (Distance Matrix & Places Autocomplete)
# ============================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

