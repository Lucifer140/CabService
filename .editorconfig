# EditorConfig is awesome: https://EditorConfig.org

root = true

# All files default settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript, TypeScript, JSX, TSX, JSON, CSS, HTML, YAML, Markdown
[*.{js,jsx,ts,tsx,json,css,scss,html,md,yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

# Python backend files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Shell scripts and env files
[*.{sh,bash,env,env.*}]
indent_style = space
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab
